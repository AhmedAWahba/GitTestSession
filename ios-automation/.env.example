# Copy this file to .env and fill in real values. Never commit .env.

BROWSERSTACK_USERNAME=
BROWSERSTACK_ACCESS_KEY=

# Local path to the signed iOS build to upload for testing.
BROWSERSTACK_IPA_PATH=../builds/app-ios.ipa

# Populated automatically by upload-ipa.js after a successful upload.
BROWSERSTACK_APP_ID=

# Device/OS to run against. See https://www.browserstack.com/list-of-browsers-and-platforms/app_automate
BROWSERSTACK_DEVICE=iPhone 14
BROWSERSTACK_OS_VERSION=16
